# V8 Windows component build configuration (2025)
# Builds V8 as DLLs for faster development iteration

# Component build: outputs multiple .dll files instead of monolithic static lib
is_component_build = true
v8_monolithic = false

is_debug = false

target_cpu = "x64"
v8_target_cpu = "x64"

# Debug features
v8_enable_backtrace = true
v8_enable_slow_dchecks = false

# Disable sandbox (not needed for desktop apps)
v8_enable_sandbox = false

# Use MSVC instead of Clang for better Windows DLL compatibility
is_clang = false
use_custom_libcxx = false

# Disable i18n to reduce binary size (enable if needed)
v8_enable_i18n_support = false

# Embed startup data in the binary
v8_use_external_startup_data = false

# Pointer compression for memory efficiency
v8_enable_pointer_compression = true

# Windows-specific optimizations
archive_seed_corpus = false
exclude_unwind_tables = false  # Keep for better debugging
chrome_pgo_phase = 0

# Symbol level (0 = none, 1 = minimal, 2 = full)
symbol_level = 1

# Visual Studio version
visual_studio_version = "2022"
