# Skia macOS component build configuration (2025)
# Builds Skia as a shared library for faster development iteration

# Component build for shared library output
is_official_build = false  # Required for component builds
is_component_build = true
is_debug = false

# Graphics backend configuration
skia_use_egl = true
skia_gl_standard = "gles"

# Enable Metal backend for better macOS performance (Skia Graphite)
skia_use_metal = true

# Disable unused features
skia_enable_android_utils = false
skia_enable_tools = false
skia_enable_gpu_debug_layers = false
skia_use_libheif = false
skia_use_lua = false
skia_use_dng_sdk = false
skia_enable_pdf = false
skia_enable_skottie = false
skia_enable_skparagraph = false
skia_enable_skshaper = false
skia_enable_svg = false
skia_use_icu = false

# Use bundled dependencies for consistent builds
# (macOS doesn't have system equivalents like Linux)
skia_use_system_expat = false
skia_use_system_freetype2 = false
skia_use_system_libjpeg_turbo = false
skia_use_system_libpng = false
skia_use_system_libwebp = false
skia_use_system_zlib = false

# Compiler configuration
cc = "clang"
cxx = "clang++"

# macOS-specific
mac_deployment_target = "11.0"  # macOS Big Sur minimum
